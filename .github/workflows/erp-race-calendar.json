{
  "jobs": [
    {
      "id": "sweep-conflicts",
      "workflow": "erp-agent-marshals.yml",
      "enabled": true,
      "mode": "interval",
      "everyMin": 15,
      "inputs": {}
    },
    {
      "id": "new-org-warmup",
      "workflow": "erp-rookie.yml",
      "enabled": false,
      "mode": "interval",
      "everyMin": 60,
      "inputs": {}
    },
    {
      "id": "hunter",
      "workflow": "erp-police.yml",
      "repo": "@fleet",
      "enabled": true,
      "mode": "slot",
      "start": "1830",
      "end": "2300",
      "inputs": { "dry_run": "false" }
    },
    {
      "id": "local-stack",
      "workflow": "erp-local-stack-matrix.yml",
      "enabled": true,
      "mode": "slot",
      "start": "0600",
      "end": "0900",
      "days": ["mon"],
      "inputs": {}
    },
    {
      "id": "prune-branches",
      "workflow": "prune-stale-branches.yml",
      "repo": "@fork",
      "enabled": true,
      "mode": "slot",
      "start": "0315",
      "end": "0600",
      "inputs": { "dry_run": "false", "stale_days": "30" }
    },
    {
      "id": "release-notes",
      "workflow": "erp-release-notes.yml",
      "enabled": true,
      "mode": "slot",
      "start": "2000",
      "end": "2300",
      "days": ["mon"],
      "inputs": { "target": "staging", "dry_run": "false" }
    },
    {
      "id": "hot-files",
      "workflow": "erp-hot-files.yml",
      "enabled": true,
      "mode": "slot",
      "start": "0300",
      "end": "0600",
      "inputs": {}
    }
  ],
  "claudeWorkflows": [
    { "workflow": "erp-agent-car.yml", "kind": "lane" },
    { "workflow": "erp-police.yml", "kind": "hunter" },
    { "workflow": "erp-agent-ambulance.yml", "kind": "ambulance" },
    { "workflow": "erp-agent-qualifying.yml", "kind": "rel-plan" },
    { "workflow": "erp-release-notes.yml", "kind": "release-notes" }
  ]
}
