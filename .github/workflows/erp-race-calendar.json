{
  "jobs": [
    {
      "id": "marshals",
      "workflow": "erp-agent-marshals.yml",
      "enabled": true,
      "mode": "interval",
      "everyMin": 15,
      "inputs": {}
    },
    {
      "id": "rookie",
      "workflow": "erp-rookie.yml",
      "enabled": false,
      "mode": "interval",
      "everyMin": 60,
      "inputs": {}
    },
    {
      "id": "fleet-warmup",
      "workflow": "erp-warm-up-laps.yml",
      "enabled": true,
      "mode": "interval",
      "everyMin": 60,
      "inputs": { "dry_run": "true" }
    },
    {
      "id": "police",
      "workflow": "erp-police.yml",
      "repo": "@fleet",
      "enabled": true,
      "mode": "slot",
      "start": "1830",
      "end": "2300",
      "inputs": { "dry_run": "false" }
    },
    {
      "id": "shakedown",
      "workflow": "erp-local-stack-matrix.yml",
      "enabled": true,
      "mode": "slot",
      "start": "0600",
      "end": "0900",
      "days": ["mon"],
      "inputs": {}
    },
    {
      "id": "workshop-sweep",
      "workflow": "prune-stale-branches.yml",
      "repo": "@fork",
      "enabled": true,
      "mode": "slot",
      "start": "0315",
      "end": "0600",
      "inputs": { "dry_run": "false", "stale_days": "30" }
    },
    {
      "id": "release-notes",
      "workflow": "erp-release-notes.yml",
      "enabled": true,
      "mode": "slot",
      "start": "2000",
      "end": "2300",
      "days": ["mon"],
      "inputs": { "target": "staging", "dry_run": "false" }
    },
    {
      "id": "collision-hotspots",
      "workflow": "erp-hot-files.yml",
      "enabled": true,
      "mode": "slot",
      "start": "0300",
      "end": "0600",
      "inputs": {}
    }
  ],
  "claudeWorkflows": [
    { "workflow": "erp-agent-car.yml", "kind": "car" },
    { "workflow": "erp-police.yml", "kind": "police" },
    { "workflow": "erp-agent-ambulance.yml", "kind": "ambulance" },
    { "workflow": "erp-agent-qualifying.yml", "kind": "qualifying" },
    { "workflow": "erp-release-notes.yml", "kind": "release-notes" }
  ]
}
